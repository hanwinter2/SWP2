#include <Servo.h>
#include <math.h>

// Arduino pin assignment
#define PIN_LED   9   // LED active-low
#define PIN_TRIG  12
#define PIN_ECHO  13
#define PIN_SERVO 10

// sonar settings
#define SND_VEL 346.0
#define PULSE_DURATION 10
#define TIMEOUT 12000UL
#define SCALE (0.001 * 0.5 * SND_VEL)

// vehicle detection distance (unit: mm)
#define _TARGET_LOW  250.0
#define _TARGET_HIGH 290.0

// servo pulse width (unit: us)
#define _DUTY_MIN 1300  // closed: reference 0 degree
#define _DUTY_MAX 2350  // open

// movement settings
#define _STEP 50
#define _STEP_DELAY 30
#define _SIGMOID_GAIN 10.0

// global variables
bool is_open = false;

Servo myservo;

float USS_measure();
void move_servo(int start_duty, int end_duty);

void setup() {
  pinMode(PIN_LED, OUTPUT);
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);

  digitalWrite(PIN_LED, HIGH);
  digitalWrite(PIN_TRIG, LOW);

  myservo.attach(PIN_SERVO, _DUTY_MIN, _DUTY_MAX);
  myservo.writeMicroseconds(_DUTY_MIN);

  Serial.begin(57600);
}

void loop() {
  float dist = USS_measure();

  Serial.print("Distance: ");
  Serial.println(dist);

  // No echo: keep the current barrier state.
  if (dist == 0.0) {
    delay(50);
    return;
  }

  // Vehicle approaches -> open the barrier.
  if (dist <= _TARGET_LOW && is_open == false) {
    digitalWrite(PIN_LED, LOW);

    move_servo(_DUTY_MIN, _DUTY_MAX);

    is_open = true;
  }

  // Vehicle moves away -> close the barrier.
  else if (dist >= _TARGET_HIGH && is_open == true) {
    move_servo(_DUTY_MAX, _DUTY_MIN);

    digitalWrite(PIN_LED, HIGH);
    is_open = false;
  }

  delay(50);
}

// Move the servo smoothly using sigmoid.
void move_servo(int start_duty, int end_duty) {
  // Values used to normalize sigmoid to the range 0~1.
  float s_min =
    1.0 / (1.0 + exp(_SIGMOID_GAIN * 0.5));

  float s_max =
    1.0 / (1.0 + exp(-_SIGMOID_GAIN * 0.5));

  for (int i = 0; i <= _STEP; i++) {
    float t = (float)i / _STEP;

    float s =
      1.0 / (1.0 + exp(-_SIGMOID_GAIN * (t - 0.5)));

    float ratio = (s - s_min) / (s_max - s_min);

    int duty = start_duty
             + (end_duty - start_duty) * ratio;

    myservo.writeMicroseconds(duty);

    delay(_STEP_DELAY);
  }

  // Set the final position exactly.
  myservo.writeMicroseconds(end_duty);
}

// Measure distance (unit: mm).
float USS_measure() {
  digitalWrite(PIN_TRIG, LOW);
  delayMicroseconds(2);

  digitalWrite(PIN_TRIG, HIGH);
  delayMicroseconds(PULSE_DURATION);
  digitalWrite(PIN_TRIG, LOW);

  return pulseIn(PIN_ECHO, HIGH, TIMEOUT) * SCALE;
}
